# MD2 IA Office — copie para .env (não versionado). Nenhum segredo vai para o frontend.

# --- Servidor ---
MD2_PORT=4310
# 127.0.0.1 = somente esta máquina. Para expor na rede (0.0.0.0) é OBRIGATÓRIO definir MD2_ADMIN_PASSWORD.
MD2_HOST=127.0.0.1
MD2_ADMIN_PASSWORD=
MD2_DATA_DIR=./data
# Hosts extras aceitos no cabeçalho Host (ex.: seu domínio atrás de proxy). Protege contra DNS rebinding.
MD2_ALLOWED_HOSTS=
# 1 = cookie de sessão com Secure (use atrás de HTTPS)
MD2_COOKIE_SECURE=0
MD2_LOG_DIR=

# --- Runtime dos agentes (Claude Agent SDK) ---
# Use UMA das opções: chave de API da Anthropic OU login já feito no Claude Code nesta máquina (`claude` -> /login).
ANTHROPIC_API_KEY=
# Opcional: modelos. Vazio = padrão da conta.
MD2_MODEL_ALFRED=
MD2_MODEL_AGENTS=

# --- Isolamento dos agentes ---
# auto = usa o sandbox de SO quando suportado (Linux: apt-get install -y bubblewrap socat)
# required = recusa executar sem isolamento (recomendado em produção) · off = desativado
MD2_AGENT_SANDBOX=auto

# --- Limites e custos ---
MD2_MAX_PARALLEL_TASKS=3
MD2_MAX_PARALLEL_EXECUTIONS=2
MD2_TASK_TIMEOUT_MIN=25
MD2_TASK_MAX_TURNS=60
MD2_TASK_MAX_ATTEMPTS=2
# Quantas vezes uma execução interrompida por reinício é retomada automaticamente
MD2_MAX_RECOVERIES=2
MD2_MAX_COST_USD_PER_TASK=5
MD2_MAX_COST_USD_PER_EXECUTION=15
MD2_MAX_COST_USD_PER_DAY=60

# --- Backup ---
# Use outro disco ou pasta sincronizada externamente.
MD2_BACKUP_DIR=./backups
MD2_BACKUP_INTERVAL_HOURS=6
MD2_BACKUP_KEEP=14

# --- Acesso a arquivos locais ---
# Pastas que os agentes podem LER além do workspace da conversa (separadas por vírgula). Vazio = nenhuma.
MD2_AUTHORIZED_DIRS=

# --- Integrações (pendentes até preencher) ---
MD2_ENABLE_PLAYWRIGHT_MCP=0
GITHUB_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
IMAGE_GENERATION_API_KEY=
