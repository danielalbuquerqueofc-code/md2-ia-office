{
  "name": "md2-ia-office",
  "version": "2.0.0",
  "private": true,
  "description": "MD2 IA Office — central de comando empresarial com Alfred e 22 agentes especializados",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/ui-smoke.mjs",
    "smoke:runtime": "tsx --env-file-if-exists=.env server/scripts/runtime-smoke.ts",
    "backup": "tsx --env-file-if-exists=.env server/scripts/backup.ts",
    "docs:agents": "tsx server/scripts/agents-report.ts",
    "audit:deps": "npm audit",
    "sandbox:check": "tsx --env-file-if-exists=.env server/scripts/sandbox-check.ts",
    "plan:preview": "tsx --env-file-if-exists=.env server/scripts/plan-preview.ts",
    "preflight": "tsx --env-file-if-exists=.env server/scripts/preflight.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
